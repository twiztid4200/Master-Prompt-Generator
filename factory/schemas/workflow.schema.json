{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow.schema.json",
  "title": "Workflow",
  "type": "object",
  "required": ["goal", "stages", "agents", "stop_conditions", "recursion_limit"],
  "additionalProperties": false,
  "properties": {
    "goal": {"type": "string"},
    "stages": {"type": "array", "items": {"type": "string", "enum": ["plan", "execute", "verify", "remember", "stop"]}},
    "agents": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "stop_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "recursion_limit": {"type": "integer", "minimum": 0, "maximum": 1},
    "budget": {"type": "object"}
  }
}
