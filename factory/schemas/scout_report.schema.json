{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scout_report.schema.json",
  "title": "ScoutReport",
  "type": "object",
  "required": ["goal", "agent", "findings", "unknowns", "provider"],
  "additionalProperties": false,
  "properties": {
    "goal": {"type": "string"},
    "agent": {"type": "string"},
    "provider": {"type": "string"},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "statement", "evidence", "source_url", "confidence", "relevance"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string", "enum": ["fact", "inference", "recommendation"]},
          "statement": {"type": "string"},
          "evidence": {"type": "string"},
          "source_url": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "license": {"type": ["string", "null"]},
          "maintenance": {"type": ["string", "null"]},
          "security": {"type": ["string", "null"]},
          "relevance": {"type": "string"}
        }
      }
    }
  }
}
